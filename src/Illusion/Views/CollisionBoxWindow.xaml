<Window x:Class="Illusion.Views.CollisionBoxWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:Illusion.Views"
        Title="Add Collision Shape"
        Width="560" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <!-- Scene tree → right-click a bone → Add Collision Shape…: a car's mesh is not what anything hits, so a
         part added in Blender needs a physics shape of its own. Only PRIMITIVES are offered — a convex hull
         is a PhysX-cooked blob and the vendored cooker cannot make one, while a box, a sphere and a capsule
         are pure numbers.

         Same shell as RestoreBackupWindow: 24px-inset content over a hairline-topped command bar, a DimLabel
         caption above each field, and the app's own DropDownField rather than a system combo box. Two short
         drop-downs instead of two tall lists — the lists made the window a wall and put a scrollbar through
         the right-hand column. -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- content -->
            <RowDefinition Height="Auto" />  <!-- command bar -->
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="24,20,24,20">

            <!-- WHICH KIND of volume, which is the question that was missing entirely. A car's collision comes
                 in two shapes and they are not variants of one thing: a type-5 volume points at an ItemDesc
                 record and is the body, the doors, the bumpers; a type-0 volume points at nothing and IS the
                 glass — all 527 shipped window volumes are type 0 and none of them anything else. Until this
                 row existed the editor could only make type 5, so every box it added was body collision
                 whichever part it was hung on, and asking for one on a window changed nothing at all. -->
            <TextBlock Style="{StaticResource DimLabel}" Text="What it is" Margin="0,0,0,4" />
            <v:DropDownField x:Name="KindBox" DisplayPath="Title" SelectionChanged="Kind_Changed"
                             ToolTip="Solid points at a physics shape; glass and zones are a plain box that says what it is by its type." />
            <TextBlock x:Name="KindHint" Style="{StaticResource DimLabel}" Margin="0,6,0,14"
                       TextWrapping="Wrap" />

            <TextBlock x:Name="ShapeCaption" Style="{StaticResource DimLabel}" Text="Shape" Margin="0,0,0,4" />
            <v:DropDownField x:Name="ShapeBox" DisplayPath="Title" SelectionChanged="Shape_Changed"
                             ToolTip="What the shape is. Only primitives — a convex hull needs a cooker we do not have." />
            <TextBlock x:Name="ShapeHint" Style="{StaticResource DimLabel}" Margin="0,6,0,14"
                       TextWrapping="Wrap" />

            <!-- Measured in game: the same shape on the BODY makes the geometry part of the car — the car
                 crashes with it and the player cannot walk through it — while on a panel it belongs to that
                 panel and only meets the world through it. Two very different results from one question. -->
            <TextBlock Style="{StaticResource DimLabel}" Text="Belongs to" Margin="0,0,0,4" />
            <v:DropDownField x:Name="PartBox" DisplayPath="Display" SelectionChanged="Part_Changed"
                             ToolTip="The deformable part the shape hangs off — it moves with that part." />
            <TextBlock x:Name="PartHint" Style="{StaticResource DimLabel}" Margin="0,6,0,14"
                       TextWrapping="Wrap" />

            <!-- The surface, back after a false negative. It was offered once, tested in game against a
                 shipped box, and looked to do nothing — so it was taken out. The test was wrong, not the
                 field: the number went in unbiased, and the raw slot id is the table index PLUS 2 (the same
                 offset the world's own collision uses, measured over 372 785 triangles). So "breakable glass"
                 at table 28 was written as a 28 the game reads as 30 — bulletproof glass. The bias is applied
                 in CarCollisionBuilder now, and this row hands it a table index, never a raw value. -->
            <TextBlock x:Name="SurfaceCaption" Style="{StaticResource DimLabel}" Text="Surface" Margin="0,0,0,4" />
            <v:DropDownField x:Name="SurfaceBox" DisplayPath="Title" SelectionChanged="Surface_Changed"
                             ToolTip="Which physics surface the shape names — what a shot or a scrape should sound and look like." />
            <TextBlock x:Name="SurfaceHint" Style="{StaticResource DimLabel}" Margin="0,6,0,14"
                       TextWrapping="Wrap" />

            <TextBlock x:Name="SizeCaption" Style="{StaticResource DimLabel}" Margin="0,0,0,4" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBox x:Name="SizeX" Grid.Row="0" Grid.Column="0" Style="{StaticResource DarkBox}" Text="0.30" />
                <TextBox x:Name="SizeY" Grid.Row="0" Grid.Column="2" Style="{StaticResource DarkBox}" Text="0.30" />
                <TextBox x:Name="SizeZ" Grid.Row="0" Grid.Column="4" Style="{StaticResource DarkBox}" Text="0.10" />

                <TextBlock x:Name="LabelX" Grid.Row="1" Grid.Column="0" Style="{StaticResource DimLabel}"
                           Margin="1,4,0,0" />
                <TextBlock x:Name="LabelY" Grid.Row="1" Grid.Column="2" Style="{StaticResource DimLabel}"
                           Margin="1,4,0,0" />
                <TextBlock x:Name="LabelZ" Grid.Row="1" Grid.Column="4" Style="{StaticResource DimLabel}"
                           Margin="1,4,0,0" />
            </Grid>

            <TextBlock x:Name="ErrorLabel" Foreground="{StaticResource StatusErrorText}" FontSize="11.5"
                       Margin="0,12,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
        </StackPanel>

        <Border Grid.Row="1" Background="{StaticResource FillHairline}" BorderBrush="{StaticResource EdgeFaint}"
                BorderThickness="0,1,0,0" Padding="24,14">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource DimLabel}" MaxWidth="280"
                           TextWrapping="Wrap" VerticalAlignment="Center"
                           Text="It lands on the part's bone — drag it into place, then Save and Build." />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource NeutralButton}" MinWidth="92" Height="32" Margin="0,0,8,0"
                            Content="Cancel" Click="Cancel_Click" />
                    <Button Style="{StaticResource AccentButton}" MinWidth="92" Height="32"
                            Content="Add" IsDefault="True" Click="Add_Click" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
