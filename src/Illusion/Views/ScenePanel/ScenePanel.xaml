<UserControl x:Class="Illusion.Views.ScenePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:Illusion.Views">

    <!-- The right-hand half of an editor window: what is loaded (stats), how to find something in it (search),
         what it is made of (the scene tree) and everything about the selected object (the property tabs).
         It knows nothing about WHERE the content came from — a district or one archive off the library shelf —
         so both editor windows host the same control and hand it their own viewport through Attach().

         The halves it composes are controls of their own: SceneTreeView is the frame hierarchy and its menu,
         ComponentTreeView is the same row of the grid read as the CAR rather than as the file, and
         ScenePropertyTabs is the tab rail, with each tab under Tabs\ a file again. What is left here is the
         panel's own furniture — the stats strip, the search box, the Components | Raw switch and the
         splitter between the halves. -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1*" MinHeight="80" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" MinHeight="60" />
        </Grid.RowDefinitions>

        <!-- Loaded-scene stats: files (SDS) · meshes · polygons. UniformGrid = three exactly
             equal cells; content centered both ways, full-height hairline separators between.
             Height comes from the host window's toolbar (HeaderHeight) so both top bars line up. -->
        <Border Grid.Row="0" Margin="8,0,8,0" Padding="0,3" CornerRadius="6"
                Height="{Binding HeaderHeight, RelativeSource={RelativeSource AncestorType=UserControl}}"
                Background="{StaticResource FillCard}" BorderBrush="{StaticResource EdgeFaint}" BorderThickness="1">
            <UniformGrid Columns="3">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="StatFiles" Style="{StaticResource StatNumber}" Text="0" />
                    <TextBlock Style="{StaticResource StatLabel}" Text="Files" />
                </StackPanel>
                <Border BorderBrush="{StaticResource EdgeSoft}" BorderThickness="1,0,0,0">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="StatMeshes" Style="{StaticResource StatNumber}" Text="0" />
                        <TextBlock Style="{StaticResource StatLabel}" Text="Meshes" />
                    </StackPanel>
                </Border>
                <Border BorderBrush="{StaticResource EdgeSoft}" BorderThickness="1,0,0,0">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="StatPolys" Style="{StaticResource StatNumber}" Text="0" />
                        <TextBlock Style="{StaticResource StatLabel}" Text="Polygons" />
                    </StackPanel>
                </Border>
            </UniformGrid>
        </Border>

        <!-- Search by name (magnifier glyph + placeholder overlay) -->
        <Grid Grid.Row="1" Margin="8,8,8,4">
            <TextBox x:Name="SearchBox" Padding="26,5,6,5" TextChanged="SearchBox_TextChanged" />
            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE721;" FontSize="12"
                       Foreground="{StaticResource TextDim}" Margin="8,0,0,0"
                       HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" />
            <TextBlock x:Name="SearchPlaceholder" Text="Search…" Foreground="{StaticResource TextFaint}"
                       Margin="28,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
        </Grid>

        <!-- Which reading of the hierarchy is on screen. Only a CAR has components, so on everything else the
             switch is not there at all and the frame tree is simply the tree. It sits above the tree because
             that is where the tree already is — the editor's layout does not move under the user. -->
        <UniformGrid x:Name="TreeModeSwitch" Grid.Row="2" Columns="2" Margin="8,0,8,6"
                     Visibility="Collapsed">
            <RadioButton x:Name="ComponentsMode" GroupName="TreeMode" Style="{StaticResource SegmentButton}"
                         Content="Components" Margin="0,0,2,0" Checked="TreeMode_Changed"
                         ToolTip="The car: doors, bumpers, windows — named and nested the way it is built" />
            <RadioButton x:Name="RawMode" GroupName="TreeMode" Style="{StaticResource SegmentButton}"
                         Content="Raw" Margin="2,0,0,0" Checked="TreeMode_Changed"
                         ToolTip="The file: frames, the name table and the resource envelopes" />
        </UniformGrid>

        <!-- The diagnosis. The editor opens every car, including the ones it cannot fully understand — those
             are the cars it is most needed for — so what did not stitch is said the moment the car opens,
             rather than found one component at a time. Shut by default: the count IS the diagnosis being
             available, and a list that opens itself takes the tree's room to repeat what has been read.
             Each line leads to the component it is about; the ones that have none — a door row naming a bone
             nothing claims — exist only here, which is the whole reason for a list beside the tinted rows. -->
        <Border x:Name="FaultStrip" Grid.Row="3" Margin="8,0,8,6" CornerRadius="6"
                Background="{StaticResource FillCard}" BorderBrush="{StaticResource EdgeFaint}"
                BorderThickness="1" Visibility="Collapsed">
            <StackPanel>
                <ToggleButton x:Name="FaultToggle" Cursor="Hand" Focusable="True"
                              Click="Faults_Click" HorizontalContentAlignment="Stretch">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Padding="8,5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <!-- Coloured by the button's own Foreground, which the panel sets from
                                         whether any of the faults is one no shipped car raises. -->
                                    <Path Grid.Column="0" Width="12" Height="12" Stretch="Uniform"
                                          Fill="Transparent"
                                          Stroke="{Binding Foreground,
                                                   RelativeSource={RelativeSource TemplatedParent}}"
                                          StrokeThickness="1.2" StrokeLineJoin="Round"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          VerticalAlignment="Center" Margin="0,0,7,0"
                                          SnapsToDevicePixels="True" Data="{StaticResource IconWarning}" />
                                    <TextBlock x:Name="Summary" Grid.Column="1" FontSize="11"
                                               Foreground="{StaticResource TextMuted}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Text="{Binding Content,
                                                      RelativeSource={RelativeSource TemplatedParent}}" />
                                    <TextBlock x:Name="Chev" Grid.Column="2" FontFamily="Segoe MDL2 Assets"
                                               FontSize="8" Text="&#xE76C;"
                                               Foreground="{StaticResource TextFaint}"
                                               VerticalAlignment="Center" Margin="8,0,0,0"
                                               RenderTransformOrigin="0.5,0.5" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Chev" Property="RenderTransform">
                                        <Setter.Value>
                                            <RotateTransform Angle="90" />
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background"
                                            Value="{StaticResource FillHover}" />
                                    <Setter TargetName="Summary" Property="Foreground" Value="White" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>

                <!-- Capped rather than free: a car with forty faults must not push the tree off the panel. -->
                <ScrollViewer x:Name="FaultScroll" MaxHeight="132" VerticalScrollBarVisibility="Auto"
                              Margin="0,0,0,4" Visibility="Collapsed">
                    <ItemsControl x:Name="FaultList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="Transparent" Padding="27,3,8,3"
                                        MouseLeftButtonUp="Fault_Click" ToolTip="{Binding What}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <!-- Muted unless it is a failure no shipped car raises:
                                                         41 of the corpus's faults are how cars are written,
                                                         and painting those as damage is how the strip stops
                                                         being read. -->
                                                    <Setter Property="Foreground"
                                                            Value="{StaticResource TextMuted}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsBreak}" Value="True">
                                                            <Setter Property="Foreground"
                                                                    Value="{StaticResource StatusWarn}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding What}" FontSize="10.5"
                                                   Foreground="{StaticResource TextFaint}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <v:SceneTreeView x:Name="Tree" Grid.Row="4" />
        <v:ComponentTreeView x:Name="ComponentTree" Grid.Row="4" Visibility="Collapsed" />

        <GridSplitter Grid.Row="5" Height="4" HorizontalAlignment="Stretch"
                      VerticalAlignment="Center" ResizeBehavior="PreviousAndNext"
                      Background="{StaticResource Splitter}" />

        <v:ScenePropertyTabs x:Name="Tabs" Grid.Row="6" />
    </Grid>
</UserControl>
