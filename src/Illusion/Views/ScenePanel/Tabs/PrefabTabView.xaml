<UserControl x:Class="Illusion.Views.PrefabTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:Illusion.Views">

    <!-- Prefab tab: how the archive's actor is assembled out of its own frames.

         Laid out like every other tab on this rail — ONE CARD PER BAND, a caption, then rows. The
         first version wrapped each band in an Expander inside a card inside a card, which is three
         nested surfaces for a list of twelve lines and looks like nothing else in the app.

         What the tab is FOR is the dangling reference. A prefab names a frame by the FNV64 hash of
         its name; a hash that names nothing does not fail, the door just stops opening, with no error
         anywhere. Renaming a bone through the Blender bridge is enough to cause it, and this is the
         only place it can be seen before the archive is built. -->

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10,10,10,4">
            <Border Style="{StaticResource PropCard}">
                <StackPanel>
                    <TextBlock Text="Prefab" Style="{StaticResource PropTitle}" />
                    <TextBlock Text="{Binding PrefabSummary}" Style="{StaticResource PropSubtitle}" />
                    <!-- Over two hundred lines in a car, so the question is usually "where is X".
                         Matches a row's name AND the frame it names, so both "mass" and "doorFL"
                         are answers. Same shape as the search over the tree above. -->
                    <Grid Margin="0,9,0,0">
                        <!-- Delay: applying a search opens every band that matches, and a car's
                             tab is ~500 rows of heavy templates (three-field vectors, pickers).
                             Rebuilding that per character put the frame rate on the floor and
                             hung the app; one pass once the typing settles costs nothing. -->
                        <TextBox x:Name="PrefabSearchBox" Style="{StaticResource InputField}"
                                 Padding="24,0,6,0"
                                 Text="{Binding PrefabSearch, UpdateSourceTrigger=PropertyChanged, Delay=220}" />
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE721;" FontSize="11"
                                   Foreground="{StaticResource TextDim}" Margin="8,0,0,0"
                                   HorizontalAlignment="Left" VerticalAlignment="Center"
                                   IsHitTestVisible="False" />
                        <TextBlock Text="Find a part or a bone…" Foreground="{StaticResource TextFaint}"
                                   FontSize="11.5" Margin="26,0,0,0" VerticalAlignment="Center"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PrefabSearch}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <TextBlock Text="Nothing here matches." Style="{StaticResource MetaLabel}"
                               Margin="2,8,0,0"
                               Visibility="{Binding PrefabNothingFound, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding PrefabEntries}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <!-- What this entry is. One line of meta, in the panel's own
                                 label/value shape — not a card of its own. -->
                            <Border Style="{StaticResource PropCard}">
                                <StackPanel>
                                    <Grid Style="{StaticResource MetaRow}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding TypeName}"
                                                   Style="{StaticResource MetaLabel}" />
                                        <TextBlock Grid.Column="1" Text="{Binding SizeText}"
                                                   Style="{StaticResource MetaValue}" />
                                    </Grid>
                                    <Grid Style="{StaticResource MetaRow}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Owner"
                                                   Style="{StaticResource MetaLabel}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Owner}"
                                                   Style="{StaticResource MetaValue}" />
                                    </Grid>
                                    <TextBlock Text="{Binding Status}" FontSize="11"
                                               TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource TextDim}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasDangling}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource StatusWarn}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- One card per band. Flat inside: caption row, then the rows. -->
                            <ItemsControl ItemsSource="{Binding Groups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,6"
                                                    Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}">
                                                <!-- The band's name gets a plate of its own, and so
                                                     does each thing in it below. One plate around
                                                     a whole band turns eight doors into one block
                                                     of thirty rows; a plate each is what makes
                                                     them read as eight doors.
                                                     The colour bar is the shape the content
                                                     browser marks an archive's sections with — an
                                                     assembly is skimmed, not read. -->
                                                <Border Style="{StaticResource GroupHeaderCard}"
                                                        Margin="0,0,0,6">
                                                <!-- Every header the same height, whether or not
                                                     it carries an add button — a row that is 24
                                                     tall beside one that is 17 reads as two kinds
                                                     of thing. -->
                                                <Grid MinHeight="24">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <!-- Closed to start with, the way Blender's
                                                         panels are: fifteen bands open at once is
                                                         a wall. The WHOLE heading opens it — a
                                                         chevron beside a caption reads as a tree,
                                                         and these are panels. -->
                                                    <ToggleButton Grid.Column="0"
                                                                  Style="{StaticResource GroupHeaderToggle}"
                                                                  ToolTip="Open or close this group"
                                                                  IsChecked="{Binding IsExpanded, Mode=TwoWay}">
                                                    <!-- Background, not Transparent-by-default:
                                                         a Grid with no brush is not hit-testable,
                                                         so the empty space beside the caption
                                                         would fall through the button. -->
                                                    <Grid Background="Transparent">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="3" Height="13"
                                                            CornerRadius="1.5" Margin="0,0,8,0"
                                                            VerticalAlignment="Center"
                                                            Background="{Binding Accent}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Title}"
                                                               Style="{StaticResource PropCaption}"
                                                               FontSize="12.5" Margin="0"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Badge}"
                                                               FontSize="10.5" Margin="7,0,0,0"
                                                               VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{StaticResource TextFaint}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasDangling}" Value="True">
                                                                        <Setter Property="Foreground" Value="{StaticResource StatusWarn}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    </Grid>
                                                    </ToggleButton>
                                                    <Button Grid.Column="1" Content="&#xE710;"
                                                            Style="{StaticResource GhostIconButton}"
                                                            ToolTip="{Binding AddTip}"
                                                            Click="PrefabAdd_Click"
                                                            Visibility="{Binding CanAdd, Converter={StaticResource BoolToVis}}" />
                                                </Grid>
                                                </Border>

                                                <!-- One plate per thing in the band. Inside it,
                                                     one shape for every row — the shape Vector3Box
                                                     already uses in its block form: the name on
                                                     its own line with whatever acts on it at the
                                                     right, and the control below across the full
                                                     width. Nothing shares a line with a field, so
                                                     nothing is ever clipped and no two rows line
                                                     up differently. -->
                                                <!-- A band that holds nothing says so. Opening
                                                     onto blank space reads as the panel having
                                                     failed, and the line is where the answer to
                                                     "so how do I get one back" goes. -->
                                                <Border>
                                                    <Border.Style>
                                                        <Style TargetType="Border" BasedOn="{StaticResource PropCard}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding IsExpanded}" Value="True" />
                                                                        <Condition Binding="{Binding IsEmpty}" Value="True" />
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="Nothing here — use + to add one."
                                                               Foreground="{StaticResource TextFaint}"
                                                               FontSize="11.5" TextWrapping="Wrap" />
                                                </Border>

                                                <!-- Opening fades the plates in rather than
                                                     snapping them on. Opacity only: the height is
                                                     whatever the content is, and animating that
                                                     would mean measuring a hundred rows a frame. -->
                                                <ItemsControl ItemsSource="{Binding Elements}"
                                                              Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}"
                                                              Opacity="0">
                                                    <ItemsControl.Style>
                                                        <Style TargetType="ItemsControl">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                    <DataTrigger.EnterActions>
                                                                        <BeginStoryboard>
                                                                            <Storyboard>
                                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                                 To="1" Duration="0:0:0.14" />
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </DataTrigger.EnterActions>
                                                                    <DataTrigger.ExitActions>
                                                                        <BeginStoryboard>
                                                                            <Storyboard>
                                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                                 To="0" Duration="0:0:0.08" />
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </DataTrigger.ExitActions>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ItemsControl.Style>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                        <Border Style="{StaticResource PropCard}">
                                                <ItemsControl ItemsSource="{Binding Rows}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Margin="{Binding Spacing}">
                                                                <!-- Name · action. Skipped for a
                                                                     position: the vector box draws
                                                                     its own name and buttons. -->
                                                                <Grid Margin="0,0,0,4"
                                                                      Visibility="{Binding HasCaption, Converter={StaticResource BoolToVis}}">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <!-- Only on a frame reference:
                                                                         the dot means the name
                                                                         resolves to a frame that is
                                                                         in this archive. -->
                                                                    <Ellipse Grid.Column="0" Width="6" Height="6"
                                                                             Margin="0,0,7,0" VerticalAlignment="Center"
                                                                             Visibility="{Binding HasDot, Converter={StaticResource BoolToVis}}">
                                                                        <Ellipse.Style>
                                                                            <Style TargetType="Ellipse">
                                                                                <Setter Property="Fill" Value="{StaticResource StatusOk}" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding Kind}" Value="Dangling">
                                                                                        <Setter Property="Fill" Value="{StaticResource StatusWarn}" />
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding Kind}" Value="Unset">
                                                                                        <Setter Property="Fill" Value="{StaticResource TextGhost}" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Ellipse.Style>
                                                                    </Ellipse>
                                                                    <TextBlock Grid.Column="1" Text="{Binding Label}"
                                                                               Style="{StaticResource MetaLabel}"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                    <!-- A yes/no is small enough to
                                                                         live on the name's line —
                                                                         the same place the Render
                                                                         tab puts its switches. -->
                                                                    <ToggleButton Grid.Column="2"
                                                                                  Style="{StaticResource ToggleSwitch}"
                                                                                  Margin="8,0,0,0"
                                                                                  IsChecked="{Binding Flag, Mode=TwoWay}"
                                                                                  Visibility="{Binding IsFlag, Converter={StaticResource BoolToVis}}" />
                                                                    <Button Grid.Column="2" Content="&#xE711;"
                                                                            Style="{StaticResource GhostIconButton}"
                                                                            Margin="8,0,0,0"
                                                                            ToolTip="{Binding RemoveTip}"
                                                                            Click="PrefabRemove_Click"
                                                                            Visibility="{Binding CanRemove, Converter={StaticResource BoolToVis}}" />
                                                                </Grid>

                                                                <!-- The control, full width. -->
                                                                <v:DropDownField DisplayPath="Name"
                                                                                 HorizontalAlignment="Stretch"
                                                                                 ItemsSource="{Binding Choices}"
                                                                                 SelectedItem="{Binding SelectedFrame, Mode=TwoWay}"
                                                                                 Visibility="{Binding IsPicker, Converter={StaticResource BoolToVis}}" />
                                                                <TextBox Style="{StaticResource InputField}"
                                                                         HorizontalAlignment="Stretch"
                                                                         Text="{Binding Number, Mode=TwoWay, StringFormat=F3, UpdateSourceTrigger=LostFocus}"
                                                                         Visibility="{Binding IsNumber, Converter={StaticResource BoolToVis}}" />
                                                                <TextBlock Text="{Binding Value}"
                                                                           Style="{StaticResource MetaValue}"
                                                                           HorizontalAlignment="Left"
                                                                           Visibility="{Binding IsText, Converter={StaticResource BoolToVis}}" />

                                                                <!-- A position, in the panel's own
                                                                     block form: name and buttons on
                                                                     top, the three fields sharing
                                                                     the full width below. -->
                                                                <v:Vector3Box Label="{Binding Label}"
                                                                              Decimals="3"
                                                                              HorizontalAlignment="Stretch"
                                                                              X="{Binding X, Mode=TwoWay}"
                                                                              Y="{Binding Y, Mode=TwoWay}"
                                                                              Z="{Binding Z, Mode=TwoWay}"
                                                                              Visibility="{Binding IsVector, Converter={StaticResource BoolToVis}}" />

                                                                <TextBlock Text="{Binding Detail}" FontSize="10"
                                                                           Margin="0,2,0,0" TextWrapping="Wrap">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="{StaticResource TextFaint}" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Detail}" Value="{x:Null}">
                                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Kind}" Value="Dangling">
                                                                                    <Setter Property="Foreground" Value="{StaticResource StatusWarn}" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                        </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
