<UserControl x:Class="Illusion.Views.ComponentTreeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Illusion.ViewModels"
             xmlns:v="clr-namespace:Illusion.Views">

    <!-- What the CAR is made of: one row per component — a door, a bumper, a licence plate — named after its
         own bone and nested by the prefab's own parent link, with the bare ones (no deform part claims them)
         standing alongside. The frame tree it takes the place of is one switch away, in the panel above. -->

    <UserControl.Resources>
        <v:ComponentGlyphConverter x:Key="ComponentGlyph" />
        <v:ComponentTintConverter x:Key="ComponentTint" />
    </UserControl.Resources>

    <Grid>
        <!-- The honest empty state: a search that matched nothing is a tree with no rows rather than an
             empty box, which reads as a panel that failed. Shares the frame tree's placard shape. -->
        <StackPanel x:Name="EmptyComponents" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="Collapsed">
            <Path Width="46" Height="46" Stretch="Uniform" Fill="Transparent" Stroke="{StaticResource StageGlyph}"
                  StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round" Data="{StaticResource IconMesh}" HorizontalAlignment="Center" />
            <TextBlock Text="No components" Foreground="{StaticResource TextMuted}"
                       FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,0" />
            <TextBlock Text="Nothing in this car matched the search" Foreground="{StaticResource TextGhost}"
                       FontSize="11" HorizontalAlignment="Center" Margin="0,6,0,0" TextAlignment="Center" />
        </StackPanel>

        <TreeView x:Name="ComponentTree" Margin="8,0,8,0" BorderThickness="0"
                  Background="Transparent"
                  VirtualizingStackPanel.IsVirtualizing="True"
                  VirtualizingStackPanel.VirtualizationMode="Recycling">
            <TreeView.ContextMenu>
                <!-- This tree edits nothing yet. Everything that acts on a row — adding a collision shape,
                     sweeping unused hulls, rolling the archive back — is on the frame tree's own menu, and a
                     car opening on its components would otherwise hide the only path to those behind a
                     switch nobody has been told about. The selected component's frame is what the frame tree
                     lands on, so the way back is one click and keeps the modder's place. -->
                <ContextMenu>
                    <MenuItem Header="Show in Raw tree" Click="ShowInRaw_Click" />
                </ContextMenu>
            </TreeView.ContextMenu>
            <TreeView.ItemContainerStyle>
                <!-- The frame tree's own row shape, minus the eye: a component is a weight group inside one
                     skinned mesh, so there is no per-component geometry to show or hide. -->
                <Style TargetType="TreeViewItem">
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TreeViewItem">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Border x:Name="Row" Grid.Row="0" CornerRadius="3"
                                            Padding="2,0" MinHeight="23">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource FillHover}" />
                                                    </Trigger>
                                                    <DataTrigger Value="True" Binding="{Binding IsSelected}">
                                                        <Setter Property="Background" Value="{StaticResource SelectionFill}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <ToggleButton x:Name="Expander" Grid.Column="0"
                                                          Style="{StaticResource TreeChevron}"
                                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" />
                                            <ContentPresenter x:Name="PART_Header" Grid.Column="1"
                                                              ContentSource="Header"
                                                              HorizontalAlignment="Stretch"
                                                              VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Margin="14,0,0,0" />
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsExpanded" Value="False">
                                        <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
                                    </Trigger>
                                    <Trigger Property="HasItems" Value="False">
                                        <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TreeView.ItemContainerStyle>
            <TreeView.Resources>
                <!-- Recursive row: kind icon · bone name · the kind in words.
                     The kind is SHOWN rather than inferred from the name: a cover names doorBL on seven
                     shipped cars, so the name is not the kind and reading it as one misleads on exactly the
                     cars this view exists for. -->
                <HierarchicalDataTemplate DataType="{x:Type vm:ComponentRowViewModel}"
                                          ItemsSource="{Binding ChildrenView}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Width="12" Height="12" Stretch="Uniform"
                              Fill="Transparent" StrokeThickness="1.15" StrokeLineJoin="Round"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              VerticalAlignment="Center" Margin="0,0,7,0" SnapsToDevicePixels="True"
                              Data="{Binding Kind, Converter={StaticResource ComponentGlyph}}">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Stroke"
                                            Value="{Binding Kind, Converter={StaticResource ComponentTint}}" />
                                    <Style.Triggers>
                                        <!-- A bone that no longer resolves: the signature of a rename made in
                                             Blender. Shown broken rather than hidden — a disappearance is the
                                             one thing a modder cannot diagnose. -->
                                        <DataTrigger Binding="{Binding IsBroken}" Value="True">
                                            <Setter Property="Stroke" Value="{StaticResource StatusError}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                        <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="White"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBroken}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource StatusError}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Grid.Column="2" Text="{Binding Kind}" Foreground="{StaticResource TextFaint}"
                                   FontSize="10.5" VerticalAlignment="Center" Margin="8,0,4,0" />
                    </Grid>
                </HierarchicalDataTemplate>
            </TreeView.Resources>
        </TreeView>
    </Grid>
</UserControl>
