<UserControl x:Class="Illusion.Views.ContentBrowser"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lib="clr-namespace:Illusion.Assets.Library;assembly=Illusion.Assets"
             xmlns:v="clr-namespace:Illusion.Views">

    <!-- The library's navigator: folders on the left, their archives on the right, a search box that queries
         the whole game rather than the open folder. A single click selects, a double click puts the archive on
         the stage — the same split every asset browser has, so nothing here has to be learned.
         The control is a strip plus a body: collapsing hides the body and leaves the strip, which is what keeps
         the viewport usable on a 1280x720 screen. -->

    <UserControl.Resources>
        <v:ByteSizeConverter x:Key="ByteSize" />

        <!-- Local copies of the scene tree's icons: this control is also built on its own (probes), so it
             cannot reach the window's resource dictionary. -->
        <StreamGeometry x:Key="BrowserFolder">M1.5,9.3 L1.5,4.2 L4.4,4.2 L5.6,5.5 L10.5,5.5 L10.5,9.3 Z</StreamGeometry>
        <StreamGeometry x:Key="BrowserArchive">M2,3.3 L10,3.3 L10,9.6 L2,9.6 Z M2,5.4 L10,5.4 M5.4,7.4 L6.6,7.4</StreamGeometry>
        <StreamGeometry x:Key="BrowserCategory">M6,1.5 L10.5,4 L10.5,8.5 L6,11 L1.5,8.5 L1.5,4 Z</StreamGeometry>

        <!-- Collapse chevron: points down while the body is open, right once it is folded away. -->
        <Style x:Key="BrowserChevron" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="3">
                            <!-- Checked = the body is showing, so the chevron points down at it; unchecked it
                                 points right, the way a folded-away panel reads everywhere else. -->
                            <TextBlock x:Name="Chev" FontFamily="Segoe MDL2 Assets" FontSize="9"
                                       Text="&#xE76C;" Foreground="#B0FFFFFF"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       RenderTransformOrigin="0.5,0.5" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chev" Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="90" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#18FFFFFF" />
                                <Setter TargetName="Chev" Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Search field, matching the property panel's inputs. -->
        <Style x:Key="BrowserSearch" TargetType="TextBox">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Height" Value="22" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="CaretBrush" Value="White" />
            <Setter Property="SelectionBrush" Value="#552D7DD2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" CornerRadius="4" Background="#1C1C20"
                                BorderBrush="#24FFFFFF" BorderThickness="1" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="22,0,6,0" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#38FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#2D7DD2" />
                                <Setter TargetName="Bd" Property="Background" Value="#25252A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Folder row: same chevron, hover and selection colours as the scene tree, so the two trees in the
             window read as one kind of thing. -->
        <Style x:Key="BrowserTreeItem" TargetType="TreeViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border x:Name="Row" Grid.Row="0" CornerRadius="3" Padding="2,0" MinHeight="22">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#12FFFFFF" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton x:Name="Expander" Grid.Column="0" Width="14" Focusable="False"
                                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent" Width="14">
                                                    <TextBlock x:Name="Chev" FontFamily="Segoe MDL2 Assets" FontSize="8"
                                                               Text="&#xE76C;" Foreground="#99FFFFFF"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               RenderTransformOrigin="0.5,0.5" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="Chev" Property="RenderTransform">
                                                            <Setter.Value>
                                                                <RotateTransform Angle="90" />
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                    <ContentPresenter x:Name="PART_Header" Grid.Column="1" ContentSource="Header"
                                                      HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Margin="12,0,0,0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#382D7DD2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Archive card. No thumbnail: a name, where it came from (only worth saying in a search hit) and
             its size. The template is the one place a picture would later go. -->
        <Style x:Key="BrowserCard" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="3" MinHeight="22"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#12FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#382D7DD2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="#1B1B1E" BorderBrush="#1AFFFFFF" BorderThickness="0,1,0,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Strip: what stays on screen when the browser is folded away. -->
            <Grid Grid.Row="0" Height="26">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ToggleButton x:Name="CollapseBtn" Grid.Column="0" Style="{StaticResource BrowserChevron}"
                              IsChecked="True" Margin="6,0,2,0" ToolTip="Show / hide the content browser"
                              Checked="Collapse_Changed" Unchecked="Collapse_Changed" />
                <TextBlock Grid.Column="1" Text="Content" Foreground="White" FontSize="11.5" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="2,0,10,0" />
                <TextBlock x:Name="PathText" Grid.Column="2" Foreground="#80FFFFFF" FontSize="11"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <Grid Grid.Column="3" Width="220" Margin="8,0,8,0">
                    <TextBox x:Name="SearchBox" Style="{StaticResource BrowserSearch}"
                             TextChanged="Search_TextChanged" />
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE721;" FontSize="11"
                               Foreground="#80FFFFFF" Margin="7,0,0,0"
                               HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" />
                    <TextBlock x:Name="SearchPlaceholder" Text="Search all archives…" Foreground="#66FFFFFF"
                               FontSize="11.5" Margin="22,0,0,0" VerticalAlignment="Center"
                               IsHitTestVisible="False" />
                </Grid>
            </Grid>

            <!-- Body: folders | contents. Collapsed with the strip's chevron. -->
            <Grid x:Name="Body" Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="FolderColumn" Width="210" MinWidth="120" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="180" />
                </Grid.ColumnDefinitions>

                <TreeView x:Name="FolderTree" Grid.Column="0" Margin="4,2,0,4" BorderThickness="0"
                          Background="Transparent"
                          ItemContainerStyle="{StaticResource BrowserTreeItem}"
                          SelectedItemChanged="FolderTree_SelectedItemChanged"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingStackPanel.VirtualizationMode="Recycling">
                    <TreeView.Resources>
                        <HierarchicalDataTemplate DataType="{x:Type lib:LibraryFolder}" ItemsSource="{Binding Folders}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="0" Width="12" Height="12" Stretch="Uniform" Fill="Transparent"
                                      StrokeThickness="1.15" StrokeLineJoin="Round" VerticalAlignment="Center"
                                      Margin="0,0,6,0" SnapsToDevicePixels="True">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Stroke" Value="#E3B341" />
                                            <Setter Property="Data" Value="{StaticResource BrowserFolder}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Kind}" Value="Category">
                                                    <Setter Property="Stroke" Value="#56C7D6" />
                                                    <Setter Property="Data" Value="{StaticResource BrowserCategory}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                                <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="White" FontSize="11.5"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" Text="{Binding TotalEntries}" Foreground="#66FFFFFF"
                                           FontSize="10.5" VerticalAlignment="Center" Margin="6,0,6,0" />
                            </Grid>
                        </HierarchicalDataTemplate>
                    </TreeView.Resources>
                </TreeView>

                <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="#22000000" />

                <Grid Grid.Column="2">
                    <ListBox x:Name="Contents" Margin="4,2,4,4" BorderThickness="0" Background="Transparent"
                             ItemContainerStyle="{StaticResource BrowserCard}"
                             IsSynchronizedWithCurrentItem="False"
                             MouseDoubleClick="Contents_MouseDoubleClick"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingStackPanel.IsVirtualizing="True"
                             VirtualizingStackPanel.VirtualizationMode="Recycling">
                        <!-- Two implicit templates, picked by row type: the pane lists a folder's sub-folders
                             above its archives, so a category that only gathers folders still opens onto
                             something, and a double click walks into it. -->
                        <ListBox.Resources>
                            <DataTemplate DataType="{x:Type lib:LibraryFolder}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Width="12" Height="12" Stretch="Uniform" Fill="Transparent"
                                          Stroke="#E3B341" StrokeThickness="1.15" StrokeLineJoin="Round"
                                          VerticalAlignment="Center" Margin="0,0,7,0" SnapsToDevicePixels="True"
                                          Data="{StaticResource BrowserFolder}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="White" FontSize="11.5"
                                               FontWeight="SemiBold" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Foreground="#66FFFFFF" FontSize="10.5"
                                               VerticalAlignment="Center" Margin="10,0,8,0"
                                               Text="{Binding TotalEntries, StringFormat={}{0} archives}" />
                                </Grid>
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type lib:LibraryEntry}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Width="12" Height="12" Stretch="Uniform" Fill="Transparent"
                                          Stroke="#B392F0" StrokeThickness="1.15" StrokeLineJoin="Round"
                                          VerticalAlignment="Center" Margin="0,0,7,0" SnapsToDevicePixels="True"
                                          Data="{StaticResource BrowserArchive}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="White" FontSize="11.5"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <!-- Where the hit came from: worth saying only while searching, when the rows
                                         no longer share one folder. -->
                                    <TextBlock Grid.Column="2" Text="{Binding FolderPath}" Foreground="#66FFFFFF"
                                               FontSize="10.5" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Value="True"
                                                                 Binding="{Binding IsSearching, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Grid.Column="3" Foreground="#66FFFFFF" FontSize="10.5" Width="62"
                                               TextAlignment="Right" VerticalAlignment="Center" Margin="10,0,8,0"
                                               Text="{Binding Size, Converter={StaticResource ByteSize}}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.Resources>
                    </ListBox>

                    <!-- Says why the pane is empty, which is otherwise indistinguishable from a stuck browser. -->
                    <TextBlock x:Name="EmptyText" Foreground="#66FFFFFF" FontSize="11.5"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="Collapsed" Text="Pick a folder on the left" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>
