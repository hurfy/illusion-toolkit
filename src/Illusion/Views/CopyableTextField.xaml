<UserControl x:Class="Illusion.Views.CopyableTextField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel DataContext="{Binding RelativeSource={RelativeSource AncestorType=UserControl}}">
        <Grid Margin="1,0,0,3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding Label}" Foreground="#80FFFFFF" FontSize="11.5"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <!-- Flat icon buttons (copy always, paste only when editable), dim glyph brightening on hover. -->
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <StackPanel.Resources>
                    <Style x:Key="IconBtn" TargetType="Button">
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="3" Padding="4,2">
                                        <TextBlock x:Name="Glyph" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                   Text="{TemplateBinding Content}" Foreground="#80FFFFFF" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#1AFFFFFF" />
                                            <Setter TargetName="Glyph" Property="Foreground" Value="White" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </StackPanel.Resources>
                <Button x:Name="PasteBtn" Style="{StaticResource IconBtn}" Content="&#xE77F;"
                        Click="Paste_Click" ToolTip="Paste" Margin="0,0,2,0" />
                <Button Style="{StaticResource IconBtn}" Content="&#xE8C8;" Click="Copy_Click" ToolTip="Copy" />
                <Button x:Name="DeleteBtn" Style="{StaticResource IconBtn}" Content="&#xE74D;"
                        Click="Delete_Click" ToolTip="Remove" Margin="2,0,0,0" Visibility="Collapsed" />
            </StackPanel>
        </Grid>

        <TextBox x:Name="Field"
                 Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                 IsReadOnly="{Binding ReadOnly}"
                 KeyDown="Field_KeyDown"
                 Foreground="White" FontSize="11.5" FontFamily="Consolas" Height="24" MinHeight="0"
                 CaretBrush="White" SelectionBrush="#552D7DD2">
            <TextBox.Style>
                <Style TargetType="TextBox">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TextBox">
                                <Border x:Name="Bd" CornerRadius="4" Background="#1C1C20"
                                        BorderBrush="#24FFFFFF" BorderThickness="1" SnapsToDevicePixels="True">
                                    <ScrollViewer x:Name="PART_ContentHost" Margin="7,0,7,0" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="#38FFFFFF" />
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="#2D7DD2" />
                                        <Setter TargetName="Bd" Property="Background" Value="#25252A" />
                                    </Trigger>
                                    <Trigger Property="IsReadOnly" Value="True">
                                        <Setter Property="Foreground" Value="#B0FFFFFF" />
                                        <Setter TargetName="Bd" Property="Background" Value="#16181C" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TextBox.Style>
        </TextBox>
    </StackPanel>
</UserControl>
