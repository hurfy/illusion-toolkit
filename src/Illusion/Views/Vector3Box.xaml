<UserControl x:Class="Illusion.Views.Vector3Box"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Language="en-US">
    <UserControl.Resources>
        <!-- Axis field: rounded dark cell with a colored X/Y/Z prefix (from Tag) and an accent border on focus. -->
        <Style x:Key="V3Field" TargetType="TextBox">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Height" Value="24" />
            <Setter Property="MinWidth" Value="64" />
            <Setter Property="CaretBrush" Value="White" />
            <Setter Property="SelectionBrush" Value="#552D7DD2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" CornerRadius="4" Background="#1C1C20"
                                BorderBrush="#24FFFFFF" BorderThickness="1" SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="Ax" Grid.Column="0"
                                           Text="{TemplateBinding Tag}" FontWeight="SemiBold" FontSize="10.5"
                                           Margin="7,0,5,0" VerticalAlignment="Center" />
                                <ScrollViewer x:Name="PART_ContentHost" Grid.Column="1" Margin="0,0,6,0"
                                              VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="X">
                                <Setter TargetName="Ax" Property="Foreground" Value="#FF6060" />
                            </Trigger>
                            <Trigger Property="Tag" Value="Y">
                                <Setter TargetName="Ax" Property="Foreground" Value="#60C060" />
                            </Trigger>
                            <Trigger Property="Tag" Value="Z">
                                <Setter TargetName="Ax" Property="Foreground" Value="#6090FF" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#38FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#2D7DD2" />
                                <Setter TargetName="Bd" Property="Background" Value="#25252A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Block-layout variant: shrinks freely (no min width) so three fields always fit the panel row. -->
        <Style x:Key="V3FieldBlock" TargetType="TextBox" BasedOn="{StaticResource V3Field}">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>

        <!-- Small flat icon button (copy / paste). -->
        <Style x:Key="V3IconBtn" TargetType="Button">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#A0FFFFFF" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1FFFFFFF" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#12FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Compact: everything on one row (label · X Y Z · paste · copy). For the status bar, where width is
             ample and vertical space is one line. -->
        <Grid x:Name="CompactRoot" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="CompactLabel" Grid.Column="0" Foreground="#B0FFFFFF" FontSize="11.5"
                       VerticalAlignment="Center" Margin="0,0,10,0" />
            <TextBox x:Name="CompactX" Grid.Column="1" Tag="X" Style="{StaticResource V3Field}" Margin="0,0,5,0" />
            <TextBox x:Name="CompactY" Grid.Column="2" Tag="Y" Style="{StaticResource V3Field}" Margin="0,0,5,0" />
            <TextBox x:Name="CompactZ" Grid.Column="3" Tag="Z" Style="{StaticResource V3Field}" Margin="0,0,6,0" />
            <Button x:Name="CompactPaste" Grid.Column="4" Style="{StaticResource V3IconBtn}"
                    Content="&#xE77F;" ToolTip="Paste" />
            <Button x:Name="CompactCopy" Grid.Column="5" Style="{StaticResource V3IconBtn}" Margin="1,0,0,0"
                    Content="&#xE8C8;" ToolTip="Copy (X, Y, Z)" />
        </Grid>

        <!-- Block: label + paste/copy on top, the three fields span the full width below. Fits a narrow panel
             (fields share the whole row, so nothing is clipped even at the panel's minimum width). -->
        <Grid x:Name="BlockRoot">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="BlockLabel" Grid.Column="0" Foreground="#B0FFFFFF" FontSize="11.5"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <Button x:Name="BlockPaste" Grid.Column="1" Style="{StaticResource V3IconBtn}"
                        Content="&#xE77F;" ToolTip="Paste" />
                <Button x:Name="BlockCopy" Grid.Column="2" Style="{StaticResource V3IconBtn}" Margin="1,0,0,0"
                        Content="&#xE8C8;" ToolTip="Copy (X, Y, Z)" />
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="BlockX" Grid.Column="0" Tag="X" Style="{StaticResource V3FieldBlock}" Margin="0,0,5,0" />
                <TextBox x:Name="BlockY" Grid.Column="1" Tag="Y" Style="{StaticResource V3FieldBlock}" Margin="0,0,5,0" />
                <TextBox x:Name="BlockZ" Grid.Column="2" Tag="Z" Style="{StaticResource V3FieldBlock}" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
