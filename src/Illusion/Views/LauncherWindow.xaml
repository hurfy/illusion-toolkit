<Window x:Class="Illusion.Views.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Illusion Toolkit"
        Width="600" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize">

    <!-- Native Fluent, like in MainWindow (map editor): no custom button outline,
         system accent on hover/focus, Segoe MDL2 glyphs, Consolas for paths, theme-neutral
         gray-alpha surfaces (readable in both light and dark themes). SizeToContent="Height"
         fits the height to the content — no empty gaps. -->
    <DockPanel>
        <!-- The MCP server the whole application shares: its state on the left, its address on the
             right (click to copy). It runs from launch to exit, so this bar is the one place that
             can always answer "is it up, and where do I point a client at it?". The game path used
             to sit here; it is already on screen — in the path box, and in the ready card below. -->
        <StatusBar DockPanel.Dock="Bottom" Padding="0" ItemsPanel="{StaticResource StatusBarTwoColumns}">
            <StatusBarItem Grid.Column="0" Padding="8,1">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="McpDot" Width="7" Height="7" VerticalAlignment="Center"
                             Margin="0,0,7,0" Fill="#C77700" />
                    <TextBlock x:Name="McpStateText" FontFamily="Consolas" FontSize="11" Opacity="0.85"
                               VerticalAlignment="Center" Text="MCP starting…" />
                </StackPanel>
            </StatusBarItem>
            <StatusBarItem Grid.Column="1" Padding="10,1">
                <StackPanel x:Name="McpAddressPanel" Orientation="Horizontal" Background="Transparent"
                            MouseLeftButtonUp="McpAddress_Click">
                    <TextBlock x:Name="McpAddressText" FontFamily="Consolas" FontSize="11" Opacity="0.85"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="380"
                               Text="" />
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

        <Grid Margin="24,20,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />   <!-- title -->
                <RowDefinition Height="Auto" />   <!-- game folder selection -->
                <RowDefinition Height="Auto" />   <!-- status card (warn / ready / unpack) -->
                <RowDefinition Height="Auto" />   <!-- editor tiles -->
            </Grid.RowDefinitions>

            <!-- Title -->
            <StackPanel Grid.Row="0" Margin="0,0,0,18">
                <TextBlock Text="Illusion Toolkit" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="Mafia II Toolkit" FontSize="12" Opacity="0.6" Margin="0,1,0,0" />
            </StackPanel>

            <!-- Game folder selection -->
            <StackPanel Grid.Row="1" Margin="0,0,0,14">
                <TextBlock Text="Game folder" FontSize="12" Opacity="0.7" Margin="2,0,0,5" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="PathBox" Grid.Column="0" Height="36" FontSize="13"
                             FontFamily="Consolas" VerticalContentAlignment="Center" Padding="8,0"
                             TextChanged="Path_TextChanged" />
                    <Button x:Name="BrowseBtn" Grid.Column="1" Width="36" Height="36" Margin="8,0,0,0"
                            FontFamily="Segoe MDL2 Assets" FontSize="15" Content="&#xE8B7;" Padding="0"
                            ToolTip="Browse for the game folder (pc or install root)" Click="Browse_Click" />
                    <Button x:Name="UnpackBtn" Grid.Column="2" Width="36" Height="36" Margin="6,0,0,0"
                            FontFamily="Segoe MDL2 Assets" FontSize="15" Content="&#xE896;" Padding="0"
                            ToolTip="Unpack all game resources to \resources" Click="Unpack_Click" />
                </Grid>
            </StackPanel>

            <!-- Status card: exactly one panel is visible at a time. Theme-neutral
                 surface (gray 50% + low alpha reads on both light and dark themes). -->
            <Border Grid.Row="2" Margin="0,0,0,22" CornerRadius="6"
                    Background="#14808080" BorderBrush="#28808080" BorderThickness="1"
                    Padding="12,10" MinHeight="52">
                <Grid VerticalAlignment="Center">

                    <!-- (a/b) invalid path or not yet unpacked -->
                    <StackPanel x:Name="WarnPanel" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7BA;" FontSize="18"
                                   Foreground="#C77700" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBlock x:Name="WarnText" FontSize="13" TextWrapping="Wrap"
                                   VerticalAlignment="Center" MaxWidth="470"
                                   Text="The game is not unpacked. Click the unpack button before opening the editors." />
                    </StackPanel>

                    <!-- (c) unpacked / ready — no progress bar or status line -->
                    <StackPanel x:Name="ReadyPanel" Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="Collapsed">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE930;" FontSize="20"
                                   Foreground="#60C060" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Game is unpacked and ready" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock x:Name="ReadyPathText" FontFamily="Consolas" FontSize="11"
                                       Opacity="0.65" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                       MaxWidth="470" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Live unpacking — shown ONLY during an actual run -->
                    <StackPanel x:Name="UnpackPanel" VerticalAlignment="Center" Visibility="Collapsed">
                        <ProgressBar x:Name="UnpackProgress" Height="6" Minimum="0" Maximum="1" Value="0" />
                        <TextBlock x:Name="UnpackStatus" FontFamily="Consolas" FontSize="12" Opacity="0.8"
                                   Margin="0,7,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Editor tiles: native Fluent buttons (system accent on hover/focus), stretched full width -->
            <UniformGrid Grid.Row="3" Rows="1" Columns="2" HorizontalAlignment="Stretch">
                <Button x:Name="MapEditorBtn" Height="140" Margin="0,0,5,0"
                        HorizontalAlignment="Stretch"
                        IsEnabled="False" Click="MapEditor_Click"
                        ToolTip="Open the 3D map editor">
                    <StackPanel>
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE826;" FontSize="42"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Map Editor" FontSize="14" Margin="0,12,0,0"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="ResourcesEditorBtn" Height="140" Margin="5,0,0,0"
                        HorizontalAlignment="Stretch"
                        IsEnabled="False"
                        ToolTip="Resource editor (coming soon)">
                    <StackPanel>
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8F1;" FontSize="42"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Resource Editor" FontSize="14" Margin="0,12,0,0"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>
            </UniformGrid>
        </Grid>
    </DockPanel>
</Window>
